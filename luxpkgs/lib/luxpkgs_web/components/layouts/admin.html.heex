<div class="min-h-screen bg-base-200 lg:grid lg:grid-cols-[16rem_1fr]">
  <aside class="hidden border-r border-base-300 bg-base-300 lg:flex lg:flex-col">
    <div class="border-b border-base-300 p-6">
      <.link navigate={~p"/"} class="flex items-center gap-2 text-lg font-semibold">
        <.logo class="h-7 w-auto" />
        <span>Luxpkgs Admin</span>
      </.link>
    </div>

    <nav class="menu flex-1 gap-2 p-4">
      <li>
        <.link navigate={~p"/admin"} class="active">
          <.icon name={:shield_check} type={:outline} class="size-4" /> Dashboard
        </.link>
      </li>
      <li>
        <.link navigate={~p"/"}>
          <.icon name={:arrow_left} type={:outline} class="size-4" /> Back to site
        </.link>
      </li>
    </nav>

    <div class="space-y-3 border-t border-base-300 p-4">
      <div class="flex items-center gap-3">
        <%= if @current_admin.user.avatar_url do %>
          <img
            src={@current_admin.user.avatar_url}
            alt={@current_admin.user.username}
            class="h-9 w-9 rounded-full"
          />
        <% else %>
          <div class="avatar avatar-placeholder">
            <div class="w-9 rounded-full bg-primary text-primary-content">
              <span>{String.first(@current_admin.user.username)}</span>
            </div>
          </div>
        <% end %>
        <div class="min-w-0">
          <p class="truncate font-medium">{@current_admin.user.username}</p>
          <p class="truncate text-xs uppercase tracking-wide text-base-content/60">
            {@current_admin.role}
          </p>
        </div>
      </div>
      <.link href={~p"/logout"} method="delete" class="btn btn-ghost btn-sm w-full justify-start">
        Log out
      </.link>
    </div>
  </aside>

  <div class="flex min-h-screen flex-col">
    <header class="flex items-center justify-between border-b border-base-300 bg-base-100 px-4 py-3 lg:hidden">
      <.link navigate={~p"/admin"} class="font-semibold">Luxpkgs Admin</.link>
      <span class="badge badge-outline uppercase">{@current_admin.role}</span>
    </header>

    <main id="admin-main" class="flex-1 p-4 lg:p-8">{render_slot(@inner_block)}</main>
  </div>
</div>
<.flash_group flash={@flash} id="admin-flash-group" />
